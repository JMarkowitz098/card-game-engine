@page "/"
@inject GameSessionService Game
@implements IDisposable

<PageTitle>Home</PageTitle>

<main>
        @if (_showingPostMulliganHand)
        {
                <PostMulliganHand Hand="@(GetActivePlayer().Hand)" OnContinue="@OnPostMulliganContinue" />
        }
        else if (Game.PendingHandOffTo != null)
        {
                <PendingHandoffTo PendingHandoffPlayerName="@GetPlayerName(Game.PendingHandOffTo!.Value)"
                                  OnReadyClicked="@OnReadyClicked" />

        }
        else
        {
                @switch (_currentPhase)
                {
                        case Phase.Title:
                                <button @onclick="OnClickStart">Start Game</button>
                                break;
                        case Phase.Setup:
                                <Setup OnSubmit="@OnSetupSubmitted" />
                                break;
                        case Phase.Mulligan:
                                <Mulligan PlayerHand="@(Game.PlayerA!.Hand)" OnSubmit="@OnMulliganChoiceClick"></Mulligan>
                                break;
                        case Phase.Play:
                                <PlayerBoardInformation Stats="@GetOpponent()" PlayerName="@GetOpponentName()"
                                                        AttackCard="@GetAttackingCard()" />
                                <PlayerBoard Stats="@GetActivePlayer()" Hand="@(GetActivePlayer().Hand)" OnCardClicked="@OnCardClicked"
                                             PlayerName="@GetActivePlayerName()" IsAttacking="@IsActivePlayerAttacking()" />
                                break;
                }
        }
</main>
