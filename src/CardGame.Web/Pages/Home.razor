@page "/"
@using CardGame.Engine
@inject GameSessionService Game
@implements IDisposable

<PageTitle>Home</PageTitle>

<main>
        @if (_showingPostMulliganHand)
        {
                <p>Your hand:</p>
                <Hand Cards="@(GetActivePlayer().Hand)" IsCardPlayable="@(_ => false)" />
                <button @onclick="@OnPostMulliganContinue">Continue</button>
        }
        else if (Game.PendingHandOffTo != null)
        {
                <p>Pass the device to @Game.PendingHandOffTo</p>
                <button @onclick="@OnReadyClicked">Ready</button>

        }
        else
        {
                @switch (_currentPhase)
                {
                        case Phase.Title:
                                <button @onclick="OnClickStart">Start Game</button>
                                break;
                        case Phase.Setup:
                                <Setup OnSubmit="@OnSetupSubmitted" />
                                break;
                        case Phase.Mulligan:
                                <Mulligan PlayerHand="@(Game.PlayerA!.Hand)" OnSubmit="@OnMulliganChoiceClick"></Mulligan>
                                break;
                        case Phase.Play:
                                <PlayerBoardInformation Stats="@(Game.PlayerB!)" PlayerName="Opponent" />
                                <PlayerBoard Stats="@(Game.PlayerA!)" Hand="@(Game.PlayerA!.Hand)" OnCardClicked="@OnCardClicked"
                                             PlayerName="Jared" />
                                break;
                }
        }
</main>


@code {
        private enum Phase { Title, Setup, Play, Mulligan };
        private Phase _currentPhase = Phase.Title;
        private PlayerId? _activePlayerId;
        private HashSet<PlayerId> _mulliganDecided = new();
        private bool _showingPostMulliganHand;

        protected override void OnInitialized()
        {
                Game.Changed += StateHasChanged;
        }

        public void Dispose()
        {
                Game.Changed -= StateHasChanged;
        }
        public void OnCardClicked(BattleCard Card)
        {
                Console.WriteLine("Clicked " + Card.Name);
        }
        public void OnClickStart()
        {
                _currentPhase = Phase.Setup;
        }
        private void OnSetupSubmitted()
        {
                Game.SetupPlayers();
                _currentPhase = Phase.Mulligan;
        }
        public void OnMulliganChoiceClick(bool willMulligan)
        {
                if (_activePlayerId == null) return;

                Game.Mulligan(_activePlayerId.Value, willMulligan);
                _mulliganDecided.Add(_activePlayerId.Value);
                _showingPostMulliganHand = willMulligan;
        }
        private void OnPostMulliganContinue()
        {
                _showingPostMulliganHand = false;
                if (_mulliganDecided.Count == 2)
                {
                        Game.BeginGame(PlayerId.PlayerA);
                        _currentPhase = Phase.Play;
                }
        }
        private void OnReadyClicked()
        {
                _activePlayerId = Game.PendingHandOffTo;
                Game.ConfirmReady();
        }
        private PlayerState GetActivePlayer()
        {
                return _activePlayerId == PlayerId.PlayerA ? Game.PlayerA! : Game.PlayerB!;
        }

}

