@page "/"
@inject GameSessionService Game
@implements IDisposable

<main>
        <h1>Leader Card Battle Bros</h1>
        @if (_showingPostMulliganHand)
        {
                <PostMulliganHand Hand="@(GetActivePlayer().Hand)" OnContinue="@OnPostMulliganContinue" />
        }
        else if (Game.PendingHandOffTo != null && Game.PendingHandOffTo != _activePlayerId)
        {
                <PendingHandoffTo PendingHandoffPlayerName="@GetPlayerName(Game.PendingHandOffTo!.Value)"
                                  OnReadyClicked="@OnReadyClicked" PreviousAction="@_previousAction" />

        }
        else
        {
                @switch (_currentPhase)
                {
                        case Phase.Title:
                                <Title OnClickStart="@OnClickStart" />
                                break;
                        case Phase.Setup:
                                <Setup OnSubmit="@OnSetupSubmitted" IsVsComputer="@_isVsComputer" />
                                break;
                        case Phase.Mulligan:
                                <Mulligan PlayerHand="@(Game.PlayerA!.Hand)" OnSubmit="@OnMulliganChoiceClick"></Mulligan>
                                break;
                        case Phase.Play:
                                <PlayPhaseBoard PreviousAction="@_previousAction" ActivePlayerStats="@GetActivePlayer()"
                                                ActivePlayerName="@GetActivePlayerName()" IsActivePlayerAttacking="@IsActivePlayerAttacking()"
                                                OpponentStats="@GetOpponent()" AttackingCard="@GetAttackingCard()" OpponentName="@GetOpponentName()"
                                                OnCardClicked="@OnCardClicked">
                                </PlayPhaseBoard>
                
                                break;
                        case Phase.GameOver:
                                <VictoryScreen WinnerName="@GetWinnerName()"></VictoryScreen>
                                break;
                }
        }
</main>
