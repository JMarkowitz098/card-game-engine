@page "/"
@using CardGame.Engine

<PageTitle>Home</PageTitle>

<main>
        <PlayerBoardInformation Stats="@_opponent_stats" PlayerName="Opponent" />
        <PlayerBoard Stats="@_stats" Hand="@_hand" PlayerName="Jared" />
</main>


@code {
        private BattleCard _testCard = new("Spark", Cost: 1, Charge: 1, Attack: 2, Defense: 1);
        private List<BattleCard> _hand = new List<BattleCard> {
                new("Spark", Cost: 1, Charge: 1, Attack: 2, Defense: 1),
                new("Ignition", Cost: 1, Charge: 1, Attack: 2, Defense: 1),
                new("Fire", Cost: 1, Charge: 1, Attack: 2, Defense: 1),
                new("Spark", Cost: 1, Charge: 1, Attack: 2, Defense: 1),
        };
        public bool isCardPlayable(BattleCard card) { return true; }
        private PlayerState _stats = new PlayerState(new List<BattleCard> {
                new("Spark", Cost: 1, Charge: 1, Attack: 2, Defense: 1),
        });
        private PlayerState _opponent_stats = new PlayerState(new List<BattleCard> {
                new("Fire", Cost: 1, Charge: 1, Attack: 2, Defense: 1),
                new("Red", Cost: 1, Charge: 1, Attack: 2, Defense: 1),
        });
}

