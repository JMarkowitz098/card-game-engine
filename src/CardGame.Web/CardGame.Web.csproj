<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>

    <!--
      Workaround for a .NET SDK bug (dotnet/sdk#54309): on macOS with SDK 10.0.300+,
      the default IntermediateOutputPath evaluates with mixed path separators
      (e.g. "obj\Debug/net10.0/"), which makes `dotnet watch` fail to find
      staticwebassets.development.json. Fixed upstream (dotnet/sdk#54536) but only
      targeted for .NET 11 preview 7, not backported to 10.x. Forcing forward
      slashes here sidesteps the bad evaluation. Safe to remove once on an SDK
      that includes the fix.
    -->
    <IntermediateOutputPath>obj/$(Configuration)/$(TargetFramework)/</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CardGame.Engine\CardGame.Engine.csproj" />
    <ProjectReference Include="..\CardGame.DeckManagement\CardGame.DeckManagement.csproj" />
  </ItemGroup>

</Project>
