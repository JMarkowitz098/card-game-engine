<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>

    <!--
      Tried forcing IntermediateOutputPath to forward slashes here as a workaround
      for a `dotnet watch` bug (dotnet/sdk#54309 - mixed path separators on macOS
      with SDK 10.0.300+). Removed: it produced a nonstandard nested obj path
      (obj/Debug/net10.0/net10.0/...) that appeared to confuse the C# Dev Kit /
      Razor language server (garbled type-resolution errors, failed code actions).
      If the dotnet-watch path error comes back, prefer `dotnet build`
      + manual browser refresh over reapplying this until SDK 11 ships the real fix.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CardGame.Engine\CardGame.Engine.csproj" />
    <ProjectReference Include="..\CardGame.DeckManagement\CardGame.DeckManagement.csproj" />
  </ItemGroup>

</Project>
