@using CardGame.Engine;

<p>Pass the device to @PendingHandoffPlayerName</p>
<button @onclick="@OnReadyClicked">Ready</button>

@code {
    [Parameter, EditorRequired]
    public required string PendingHandoffPlayerName { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnReadyClicked { get; set; }
}