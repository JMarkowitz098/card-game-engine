@using CardGame.Engine

<section>
    <h3 class="visually-hidden">Player Stats</h3>
    <dl class="stats-text">
        <dt class="health">Health</dt>
        <dd>@Stats.CurrentHealth/@MaxHealth</dd>
    </dl>
    <dl class="stats-text">
        <dt class="energy">Energy</dt>
        <dd>@Stats.CurrentEnergy/@Stats.MaxEnergy</dd>
    </dl>

</section>

@code {
    [Parameter, EditorRequired]
    public required PlayerState Stats { get; set; }

    private const int MaxHealth = 10;
}