@using CardGame.Engine

<section>
    <h3>Player Stats</h3>
    <span>Health: @Stats.CurrentHealth/@MaxHealth</span>
    <span>Energy: @Stats.CurrentEnergy/@Stats.MaxEnergy</span>
</section>

@code {
    [Parameter, EditorRequired]
    public required PlayerState Stats { get; set; }

    private const int MaxHealth = 10;
}