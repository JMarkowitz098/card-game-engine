@using CardGame.Engine

<section>
    <h3>Hand</h3>
    <ul style="display: flex; justify-content: space-evenly;">
        @foreach (var card in Cards)
        {
            <li><Card 
                GameCard="@card" 
                IsPlayable="@IsCardPlayable(card)" 
                OnClick="@OnCardClicked" 
            />
            </li>
        }
    </ul>
</section>

@code {
    [Parameter, EditorRequired]
    public required List<BattleCard> Cards { get; set; }

    [Parameter]
    public EventCallback<BattleCard> OnCardClicked { get; set; }

    [Parameter, EditorRequired]
    public required Func<BattleCard, bool> IsCardPlayable { get; set; }
}