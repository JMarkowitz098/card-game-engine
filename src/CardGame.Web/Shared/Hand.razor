@using CardGame.Engine

<div>
    <h3>Hand</h3>
    <div style="display: flex;">
        @foreach (var card in Cards)
        {
            <Card 
                GameCard="card" 
                IsPlayable="IsCardPlayable(card)" 
                OnClick="OnCardClicked" 
            />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public List<Engine.BattleCard> Cards { get; set; }

    [Parameter]
    public EventCallback<Engine.BattleCard> OnCardClicked { get; set; }

    [Parameter]
    public required Func<Engine.BattleCard, bool> IsCardPlayable { get; set; }
}