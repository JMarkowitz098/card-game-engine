@using CardGame.Engine

<section>
    <h3>Hand</h3>
    <ul style="display: flex; justify-content: space-evenly;">
        @foreach (var card in Cards)
        {
            <li>
                <Card GameCard="@card" IsPlayable="@IsCardPlayable(card)" OnClick="@OnCardClicked" />
            </li>
        }
        <li><button @onclick="() => OnCardClicked.InvokeAsync(null)">Pass</button></li>
    </ul>
</section>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<BattleCard> Cards { get; set; }

    [Parameter]
    public EventCallback<BattleCard> OnCardClicked { get; set; }

    [Parameter, EditorRequired]
    public required Func<BattleCard, bool> IsCardPlayable { get; set; }
}