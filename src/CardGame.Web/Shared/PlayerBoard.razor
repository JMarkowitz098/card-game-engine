@using CardGame.Engine

<div>
    <PlayerStats Stats="@Stats" />
    <Hand Cards="@Hand" IsCardPlayable="@IsCardPlayable" />
    <Pile Name="Draw Pile" NumCards="@Stats.DrawPile.Count" />
    <Pile Name="Discard Pile" NumCards="@Stats.DiscardPile.Count" />
</div>

@code {
    [Parameter, EditorRequired]
    public required Engine.PlayerState Stats { get; set; }

    [Parameter, EditorRequired]
    public List<Engine.BattleCard> Hand { get; set; }

    public bool IsCardPlayable(BattleCard card) { return true; }
}