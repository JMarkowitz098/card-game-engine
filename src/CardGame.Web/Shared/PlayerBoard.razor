@using CardGame.Engine

<div style="border-style: solid">
    <PlayerBoardInformation Stats=@Stats PlayerName="@PlayerName" />
    <Hand Cards="@Hand" IsCardPlayable="@IsCardPlayable" />
</div>

@code {
    [Parameter, EditorRequired]
    public required PlayerState Stats { get; set; }

    [Parameter, EditorRequired]
    public required List<BattleCard> Hand { get; set; }

    [Parameter, EditorRequired]
    public required string PlayerName { get; set; }

    public bool IsCardPlayable(BattleCard card) { return true; }
}