@using CardGame.Engine

<section style="border-style: solid">
    <PlayerBoardInformation Stats="@Stats" PlayerName="@PlayerName" />
    <Hand Cards="@Hand" OnCardClicked="@OnCardClicked" IsCardPlayable="@IsCardPlayable" />
</section>

@code {
    [Parameter, EditorRequired]
    public required PlayerState Stats { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<BattleCard> Hand { get; set; }

    [Parameter, EditorRequired]
    public required string PlayerName { get; set; }

    [Parameter]
    public EventCallback<BattleCard> OnCardClicked { get; set; }

    public bool IsCardPlayable(BattleCard card) { return true; }
}