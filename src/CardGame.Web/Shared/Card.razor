@using CardGame.Engine

<button class="card-button" @onclick="() => OnClick.InvokeAsync(GameCard)">
    <article class="card-article">
        <div class="card-text">
            <dl class="card-text-element">
                <dt>Cost</dt>
                <dd>@GameCard.Cost</dd>
                <dt>Charge</dt>
                <dd>@GameCard.Charge</dd>
            </dl>
            <h3>@GameCard.Name</h3>
            <img alt="I am a card image" />
            <dl class="card-text-element">
                <dt>Attack</dt>
                <dd>@GameCard.Attack</dd>
                <dt>Defense</dt>
                <dd>@GameCard.Defense</dd>
            </dl>
        </div>
    </article>
</button>

@code {
    [Parameter, EditorRequired]
    public required BattleCard GameCard { get; set; }

    [Parameter]
    public bool IsPlayable { get; set; }

    [Parameter]
    public EventCallback<BattleCard> OnClick { get; set; }
}