@using CardGame.Engine

<div @onclick="() => OnClick.InvokeAsync(GameCard)">
    <div style="border-style: solid;">
        <p>@GameCard.Name</p>
        <p>Cost: @GameCard.Cost</p>
        <p>Charge: @GameCard.Charge</p>
        <p>Attack: @GameCard.Attack</p>
        <p>Defense: @GameCard.Defense</p>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public required BattleCard GameCard { get; set; }

    [Parameter]
    public bool IsPlayable { get; set; }

    [Parameter]
    public EventCallback<BattleCard> OnClick { get; set; }
}