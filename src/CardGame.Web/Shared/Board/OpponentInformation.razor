@using CardGame.Engine

<section class="opponent-info">
    <h2>@Name Information</h2>
    <PlayerBoardInformation Stats="@Stats" />
    <section class="placeholder">
        <h3 class="title">Attacking Card</h3>
        @if (AttackCard != null)
        {
            <Card GameCard="@AttackCard"></Card>
        }
    </section>
    <section class="placeholder">
        <h3 class="title">Game Log</h3>
        <p>@PreviousAction</p>
    </section>
</section>

@code {
    [Parameter, EditorRequired]
    public required PlayerState Stats { get; set; }

    [Parameter, EditorRequired]
    public required string Name { get; set; }

    [Parameter]
    public BattleCard? AttackCard { get; set; }

    [Parameter]
    public string PreviousAction { get; set; }
}