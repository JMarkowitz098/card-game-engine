<section class="handoff-section">
    <h2>Pass the device to @PendingHandoffPlayerName</h2>
    <p>@PreviousAction</p>
    <button @onclick="@OnReadyClicked">Ready</button>
</section>

@code {
    [Parameter, EditorRequired]
    public required string PendingHandoffPlayerName { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnReadyClicked { get; set; }

    [Parameter, EditorRequired]
    public string PreviousAction { get; set; }
}